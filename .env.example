# Resend API key used by the contact form (app/api/contact/route.js).
# Create one at https://resend.com/api-keys and copy this file to .env.local.
RESEND_API_KEY=

# Optional. Resend only accepts a custom sender once you have verified its
# domain; leave this unset to use Resend's onboarding address.
# CONTACT_FROM_EMAIL="Portfolio Inquiry <hello@yourdomain.com>"
